# Path to the vault folder (Inbox/, Logs/, WIPs/, Finalized/, log-overview.md,
# CLAUDE.md, .index/). Defaults to ./vault — stays local on this machine,
# never needs to be synced anywhere.
VAULT_PATH=./vault

# Where raw voice-memo transcripts land from your phone. This is the ONLY
# folder that needs to live somewhere synced (e.g. an iCloud Drive folder).
# Leave unset to just use VAULT_PATH/Inbox-Raw (local, no phone sync).
INBOX_RAW_PATH=

# Used by the chat panel (Mode B) for direct Claude API calls.
ANTHROPIC_API_KEY=

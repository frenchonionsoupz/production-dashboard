# Path to the ProductionDashboard vault folder (Inbox-Raw/, Inbox/, Logs/, WIPs/,
# Finalized/, log-overview.md, CLAUDE.md, .index/). Point this at your real
# iCloud Drive folder in production. Defaults to ./vault for local dev.
VAULT_PATH=./vault

# Used by the chat panel (Mode B) for direct Claude API calls.
ANTHROPIC_API_KEY=
